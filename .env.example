# Copy to .env and fill in. NEVER commit .env.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Copy exact model IDs from the Token Factory model catalog.
# Nemotron Nano-class for fast/cheap calls:
MODEL_FAST=
# Nemotron Super or Ultra for planning and judgment:
MODEL_REASONING=

# Sandboxes: check the docs for which variables/headers the Contree SDK needs.
# (Nebius's example repos use a project ID, e.g. CONTREE_PROJECT.)
CONTREE_PROJECT=

# Optional, later:
TAVILY_API_KEY=
