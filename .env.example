# Copy to .env and fill in. NEVER commit .env.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Copy exact model IDs from the Token Factory model catalog.
# Nemotron Nano-class for fast/cheap calls:
MODEL_FAST=
# Nemotron Super or Ultra for planning and judgment:
MODEL_REASONING=

# Sandboxes (Contree SDK). Uses NEBIUS_API_KEY above + your Token Factory project ID.
# contree-sdk 0.3.6 reads NEBIUS_PROJECT_ID (the CLI docs call it CONTREE_PROJECT / NEBIUS_AI_PROJECT).
NEBIUS_PROJECT_ID=
CONTREE_URL=https://api.tokenfactory.nebius.com/sandboxes/

# Optional, later:
TAVILY_API_KEY=
